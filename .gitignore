*.onnx
*.onnx.data

# Runtime WebGPU (ORT) — recopié depuis node_modules par scripts/postinstall-ort.cjs
*.wasm
/public/ort

# Vercel
.vercel

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db
